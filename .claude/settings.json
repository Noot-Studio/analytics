{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun .claude/hooks/block-env-edits.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun fix"
          },
          {
            "type": "command",
            "command": "bun .claude/hooks/check-types-scoped.ts"
          }
        ]
      }
    ]
  }
}
