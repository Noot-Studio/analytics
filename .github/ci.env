# Canonical env for CI build/test (compile + unit tests; never boots services).
# Loaded into $GITHUB_ENV by ci.yml and claude.yml — single source of truth so
# the two workflows can't drift. Add a var here and both pick it up.
#
# Bypass @t3-oss/env-core runtime validation; CI only compiles, never runs.
SKIP_ENV_VALIDATION=true
# Prisma generate (db's postinstall) resolves DATABASE_URL via prisma.config;
# a placeholder satisfies it — generate never connects.
DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder
# web's `check-types` runs `vite build`, which bakes these VITE_* values.
VITE_SERVER_URL=http://localhost:3000
VITE_DOCS_URL=http://localhost:3002
