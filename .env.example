# Copy to .env at the repo root. Every app/package .env is a symlink to this file.
# Each schema validates its own subset:
#   - apps/server     → packages/env/src/server.ts
#   - apps/web        → packages/env/src/web.ts (only VITE_* exposed to the browser)
#   - apps/ingest     → packages/env/src/server.ts

# --- Better Auth ---
# Min 32 chars. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:3000

# --- Steam (OpenID sign-in) ---
# Get a key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=replace-me

# --- CORS (dashboard origin) ---
CORS_ORIGIN=http://localhost:3001

# --- Postgres (Prisma) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/sbox-analytics

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Redpanda / Kafka (host-exposed listener from docker-compose) ---
KAFKA_BROKERS=localhost:19092
KAFKA_EVENTS_TOPIC=events

# --- ClickHouse ---
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=analytics
CLICKHOUSE_PASSWORD=analytics

# --- Ports ---
# Override any of these to avoid conflicts with other local services.
SERVER_PORT=3000
WEB_PORT=3001
FUMADOCS_PORT=3002
INGEST_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=19092
REDPANDA_SCHEMA_PORT=18081
REDPANDA_PROXY_PORT=18082
REDPANDA_ADMIN_PORT=19644
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- apps/web (browser bundle — only VITE_* are exposed) ---
VITE_SERVER_URL=http://localhost:3000
# Public documentation site (apps/fumadocs); dev server runs on port 4000
VITE_DOCS_URL=http://localhost:3002

# Optional. One of: development | production | test
# NODE_ENV=development
