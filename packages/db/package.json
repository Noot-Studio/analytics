{
  "name": "@sbox-analytics/db",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./mock": {
      "default": "./mock/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "bun run seed/index.ts",
    "postinstall": "prisma generate",
    "db:studio": "prisma studio",
    "db:start": "docker compose up -d",
    "db:watch": "docker compose up",
    "db:stop": "docker compose stop",
    "db:down": "docker compose down"
  },
  "dependencies": {
    "@clickhouse/client": "^1.8.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@sbox-analytics/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "pg": "^8.17.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@sbox-analytics/config": "workspace:*",
    "@types/pg": "^8.16.0",
    "prisma": "^7.8.0",
    "typescript": "catalog:"
  }
}
