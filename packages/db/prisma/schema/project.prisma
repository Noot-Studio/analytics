model Project {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  apiKeys   ApiKey[]

  @@index([ownerId])
  @@map("project")
}

model ApiKey {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Publishable key shipped with the SDK; sent as X-Api-Key by the Ingest API.
  publishableKey String   @unique
  label         String?
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([projectId])
  @@map("api_key")
}
