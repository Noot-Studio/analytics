// A Metric is a named, saved query definition (the query-config DSL) owned by
// an organization. Dashboard widgets reference metrics by id; alerts will too.
model Metric {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  config         Json         @default("{}")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@map("metric")
}
